# MN25 uses local demo data by default. Add production integrations only when available.
NEXT_PUBLIC_API_BASE=http://localhost:4000

# Authentication is cookie-based; do not add auth tokens to localStorage.

# Keep the old frontend-only seed state disabled in production. Enable only
# when the real backend/data source is genuinely unavailable for local demos.
NEXT_PUBLIC_ENABLE_DEMO_FALLBACK=false
