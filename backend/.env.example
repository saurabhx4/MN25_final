# Postgres + PostGIS
DATABASE_URL="postgresql://mn25:mn25@localhost:5432/mn25?schema=public"

# Authentication
# Use a long, random secret for production session infrastructure.
WEB_ORIGIN="http://localhost:3000"

# Queue / cache
REDIS_URL="redis://localhost:6379"

# Dashboard cache TTLs (seconds)
DASHBOARD_SUMMARY_CACHE_TTL=30
TOP_ZONES_CACHE_TTL=60
MN_DISTRIBUTION_CACHE_TTL=120

PORT=4000

# --- Explore page (geospatial backend) -------------------------------------

# Geocoder (place search) — Nominatim is public and needs no key, but a
# descriptive User-Agent is required by their usage policy.
NOMINATIM_BASE_URL="https://nominatim.openstreetmap.org"
NOMINATIM_USER_AGENT="MN25-Mineral-Intelligence/1.0 (contact: ops@mn25.example)"

# Satellite scene search — any STAC-compliant catalog (Copernicus Data Space,
# Element84 Earth Search, etc). Leave unset to have /api/satellite/scenes
# report "unavailable" instead of fabricating scenes.
# SATELLITE_STAC_URL="https://earth-search.aws.element84.com/v1"
# SATELLITE_STAC_COLLECTION="sentinel-2-l2a"
# SATELLITE_PROVIDER_NAME="Element84 Earth Search (Sentinel-2)"

# Optional layer providers — unset ones are reported as "unavailable" by
# GET /api/geospatial/layers rather than silently turned on.
# GEOLOGY_LAYER_SOURCE_URL=
# GEOLOGY_LAYER_PROVIDER_NAME=
# ELEVATION_LAYER_SOURCE_URL=
# ELEVATION_LAYER_PROVIDER_NAME=
# SPECTRAL_ENGINE_URL=
# HISTORICAL_IMAGERY_SOURCE_URL=
# HISTORICAL_IMAGERY_PROVIDER_NAME=

# Region-select AI scan (POST /api/analyses/region) — the geospatial
# inference microservice. Jobs fail explicitly, rather than fabricating a
# result, when this isn't configured. Shares the pattern of AI_ENGINE_URL.
# GEOSPATIAL_ENGINE_URL="http://localhost:5100"

# Max area (km²) a user can submit as a region-analysis selection.
MAX_REGION_ANALYSIS_AREA_KM2=50000

# --- AI Analysis page (POST /api/ai-analysis, /api/spectral-analysis) ------

# Real prospectivity inference for a single documented zone
# (POST /api/ai-analysis with subjectType "zone"). Leave unset to have the
# job fail explicitly instead of fabricating a prediction.
# AI_ENGINE_URL="http://localhost:5000"

# Real spectral feature extraction (band statistics/indices/anomaly maps) for
# POST /api/spectral-analysis. Leave unset to have the request return
# status "unavailable" instead of fabricating spectral observations.
# SPECTRAL_ENGINE_URL="http://localhost:5200"

# --- Projects / AI Action Center -------------------------------------------
# Production action plans are generated by the configured decision engine.
# Leave unset to return an explicit unavailable/failed action plan rather than
# inventing operational recommendations.
# AI_ENGINE_URL="http://localhost:5000"

# Report PDF storage. Local storage is the default; replace with an object-storage adapter in production.
REPORT_STORAGE_DIR=./storage/reports

STORAGE_VERSION=local-filesystem
AI_ENGINE_VERSION=
GEOSPATIAL_ENGINE_VERSION=
SATELLITE_PIPELINE_VERSION=
FORECASTING_ENGINE_VERSION=
REPORT_SERVICE_VERSION=

# Optional production forecasting microservice. If unset, MN25 uses the
# persisted statistical forecasting baseline; it never falls back to frontend mock data.
# FORECASTING_ENGINE_URL="http://localhost:5300"
# Dataset ingestion
DATASET_STORAGE_DIR=./storage/datasets
DATASET_MAX_UPLOAD_BYTES=262144000

# MN25 ML engine / data pipeline
MN25_DATA_ROOT=../data
MN25_DATA_READINESS_REPORT=../data/reports/dataset_readiness/DATASET_READINESS_REPORT.md
MN25_CANONICAL_DATASET_PATH=../data/training/classification/canonical_training.parquet
MN25_ML_ENGINE_DIR=../ml_engine
MN25_ML_CODE_VERSION=mn25-ml-1.0.0
PYTHON_BIN=python


# --- Railway ---
# Backend service: Root Directory = backend. Add a PostGIS Postgres + a Redis service.
# DATABASE_URL=${{Postgres.DATABASE_URL}}   (must be a PostGIS-enabled Postgres)
# REDIS_URL=${{Redis.REDIS_URL}}
# JWT_SECRET=<long random string>
# NODE_ENV=production
# WEB_ORIGIN=https://<frontend>.up.railway.app   (exact origin, no trailing slash)
# COOKIE_SAMESITE=none    (frontend and backend are on different domains)
